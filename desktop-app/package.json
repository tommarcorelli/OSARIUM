{
  "name": "osarium-desktop",
  "version": "1.0.0",
  "description": "Appli desktop OSARIUM (Electron) — charge le site statique existant et ajoute la détection matérielle réelle (CPU/GPU/RAM/disque) via systeminformation, gratuit et 100% local.",
  "author": "OSARIUM",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.osarium.desktop",
    "productName": "OSARIUM",
    "copyright": "OSARIUM",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "..", "to": "site", "filter": ["**/*", "!desktop-app/**", "!downloads/**", "!.git/**"] }
    ],
    "win": { "target": ["nsis"], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OSARIUM",
      "artifactName": "OSARIUM-Setup.exe"
    },
    "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.utilities" },
    "dmg": { "title": "OSARIUM" },
    "linux": { "target": ["AppImage", "deb"], "icon": "build/icon.png", "category": "Utility", "maintainer": "OSARIUM" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "systeminformation": "^5.23.0"
  }
}
